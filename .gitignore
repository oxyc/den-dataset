.build/
out/
*.env
.DS_Store
*.xcodeproj
.swiftpm/
out-vecnow*/
out-*/
# No trailing slash, so a SYMLINK is covered too. `out-t02` is a symlink to `legacy/out-t02`, and git
# treats a symlink as a file, so the pattern above never matched it — it sat untracked in every status,
# one `git add .` away from committing a link to gigabytes of derived data.
out-*
__pycache__/

# TMDB detail-response cache (TMDBCache) — large, machine-local, regenerable.
.cache/

# Superseded run directories, kept on disk rather than deleted because out-*/ was never committed and
# there is no history to recover them from. Same reason as out-*/: derived data, gigabytes, regenerable
# in principle but expensive. See CLAUDE.md.
legacy/
data/wikipedia-plots-v1.jsonl.gz
