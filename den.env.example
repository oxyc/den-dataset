# den-dataset secrets — copy to `den.env` (gitignored via *.env) and fill in.
#   cp den.env.example den.env   # then edit den.env
# The run wrapper (scripts/enrich-run.sh) sources this and, if the Enterprise
# username/password are set, exchanges them at the login endpoint for a 24h
# bearer token that WikipediaSource uses for cleaner, pre-sectioned plots.

# REQUIRED for enrich (TMDB metadata: overview, keywords, credits).
TMDB_API_KEY=

# OPTIONAL — Wikimedia Enterprise (higher rate limit + pre-parsed plot text).
# Leave blank to use the free public Wikipedia action API instead (same plot
# coverage, slower + relies on our wikitext stripping). A free Enterprise
# account's username/password work here.
WIKIMEDIA_ENTERPRISE_USERNAME=
WIKIMEDIA_ENTERPRISE_PASSWORD=

# den-embed (bge-m3 int8) — only needed later at `assemble`, not for plot-finding.
DEN_EMBED_URL=http://localhost:8791
