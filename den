#!/usr/bin/env python3
"""den — the entry point. It dispatches; it does not implement.

    den stages                     what runs, in what order, and what each stage reads and writes
    den stage <name> [options]     run one
    den run [options]              run them all, in order

Options (both run forms):

    --out-dir DIR                  where artifacts are read and written  (default: out)
    --dataset-version VER          the version the filenames carry       (required)
    --stamp-meta PATH              the manifest to declare the outputs in
    --expect N                     the title count the corpus join is held to
    --pause-ms N                   milliseconds the embed pass idles between requests
    --limit N                      stop the embed pass after N new titles
    --plan                         the classify pass validates and reports, and buys nothing
    --set NAME=PATH                point one artifact at a path outright, repeatable — repeat the same
                                   NAME to name every shard of a set

The work is in `pipeline/`: `pipeline/__init__.py` holds the order, and each stage module holds its own
inputs and outputs. Anything this file grows beyond argument parsing belongs there instead.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import pipeline  # noqa: E402


def describe():
    """The pipeline, printed. The answer to all three questions the tree used to need a search for.

    The producer column is the derived registry, not a field on the artifact: for anything the pipeline
    builds it names the stage's own rule, so the listing and the guard cannot disagree.
    """
    producers = pipeline.producers()
    for number, module in enumerate(pipeline.stages(), start=1):
        print(f"{number}. {module.NAME}")
        for role, declared in (("reads ", module.INPUTS), ("writes", module.OUTPUTS)):
            for entry in (pipeline.bind(e) for e in declared):
                artifact = entry.artifact
                note = "" if artifact.required else "  (optional)"
                if artifact.shards:
                    note += "  (every shard)"
                print(f"     {role}  {artifact.name:<16} {artifact.filename:<32} "
                      f"{producers[artifact.name][0]}{note}")
    return 0


def context(args):
    """A run's paths and settings.

    A NAME given to `--set` twice becomes the list of shards under one flag, so a pass written under
    another run's name can be pointed at without renaming its files.
    """
    overrides = {}
    for pair in args.set:
        if "=" not in pair:
            raise pipeline.StageError(f"--set wants NAME=PATH, got {pair!r}")
        name, path = pair.split("=", 1)
        if name in overrides:
            seen = overrides[name]
            overrides[name] = ([*seen, path] if isinstance(seen, list) else [seen, path])
        else:
            overrides[name] = path
    return pipeline.Context(out_dir=args.out_dir, dataset_version=args.dataset_version,
                            overrides=overrides, stamp_meta=args.stamp_meta or "",
                            expect=args.expect, pause_ms=args.pause_ms, limit=args.limit,
                            plan=args.plan)


def execute(module, ctx):
    print(f"==> {module.NAME}", file=sys.stderr)
    made = module.run(ctx)
    print(f"==> {module.NAME}: {made}", file=sys.stderr)


def main(argv=None):
    parser = argparse.ArgumentParser(prog="den", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("stages", help="list the pipeline")

    def with_options(sub):
        sub.add_argument("--out-dir", default="out")
        sub.add_argument("--dataset-version", required=True)
        sub.add_argument("--stamp-meta")
        sub.add_argument("--expect", type=int, help="the title count the corpus join is held to")
        sub.add_argument("--pause-ms", type=int, default=0,
                         help="milliseconds the embed pass idles between requests")
        sub.add_argument("--limit", type=int, help="stop the embed pass after N new titles")
        sub.add_argument("--plan", action="store_true",
                         help="the classify pass validates and reports its call plan, and buys nothing")
        sub.add_argument("--set", action="append", default=[], metavar="NAME=PATH")
        return sub

    run = with_options(commands.add_parser("run", help="run every stage, in order"))
    run.add_argument("--publish", action="store_true",
                     help="also run the publishing stage, which CLOBBERS the moving data-latest release")
    run.add_argument("--spend", action="store_true",
                     help="also run the stages that BUY from a paid provider (the classify pass is ~$20)")
    with_options(commands.add_parser("stage", help="run one stage")).add_argument("name")

    args = parser.parse_args(argv)
    try:
        if args.command == "stages":
            return describe()
        ctx = context(args)
        if args.command == "stage":
            chosen = [pipeline.stage(args.name)]
        else:
            # `run` stops before the stages whose effect reaches outside the out-dir, unless asked for that
            # effect by name. Everything else writes into the out-dir and can be run again, so a wrong
            # `den run` costs time.
            #
            # Two gates rather than one, because they are different consequences and an operator wants one
            # without the other: a re-label buys rows again without touching what is served, and a publish
            # replaces the served dataset without buying anything. Naming each also makes the unattended
            # job say out loud what it does, rather than inheriting it from the stage order.
            #
            # SPENDS is not covered by the resume. The pass classifies only what is missing, so a repeat
            # costs nothing it already has — but an article dump rebuilt with more titles makes the
            # difference missing, and buys it. `--plan` cannot warn about that either: it estimates the
            # whole input without consulting what is done, so it reads ~$20 whether the run would buy
            # everything or nothing.
            chosen = [m for m in pipeline.stages()
                      if (args.publish or not m.PUBLISHES) and (args.spend or not m.SPENDS)]
        for module in chosen:
            execute(module, ctx)
    except pipeline.StageError as refusal:
        print(f"error: {refusal}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
